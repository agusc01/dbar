#!/bin/sh
set -eu

# The repository lives at ~/.config/dbar when installed normally.
DBAR_HOME=${DBAR_HOME:-"$HOME/.config/dbar"}
mode_file="$DBAR_HOME/color-mode"
runtime_directory="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/dbar"
pid_file="$runtime_directory/dbar.pid"
lock_directory="$runtime_directory/lock"

# Only trust a PID if it still belongs to this specific bar executable.
running_pid() {
    [ -f "$pid_file" ] && [ ! -L "$pid_file" ] || return 1
    IFS= read -r pid < "$pid_file" || return 1
    case "$pid" in
        ''|0|*[!0-9]*) return 1 ;;
    esac
    kill -0 "$pid" 2>/dev/null || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    tr '\000' '\n' < "/proc/$pid/cmdline" | grep -Fx "$DBAR_HOME/dbar" >/dev/null 2>&1
}

# Read the persisted color mode, defaulting to color when unset.
load_color_mode() {
    DBAR_COLOR_MODE=on
    if [ -f "$mode_file" ] && [ ! -L "$mode_file" ]; then
        IFS= read -r DBAR_COLOR_MODE < "$mode_file" || :
    fi
    case "$DBAR_COLOR_MODE" in
        on|off) ;;
        *) DBAR_COLOR_MODE=on ;;
    esac
}

# Build untagged preview text and clickable root-window status.
# Arguments: one-character ID, visible text and color.
append_status_segment() {
    [ -n "$2" ] || return 0

    if [ -n "$output" ]; then
        output="${output}${DBAR_SEPARATOR}"
        tagged_output="${tagged_output}${DBAR_SEPARATOR}"
    fi

    status_text=$2
    if [ "$DBAR_COLOR_MODE" = on ] && [ -n "$3" ]; then
        status_text="${3}${2}${DBAR_NORMAL}"
    fi
    output="${output}${status_text}"
    tagged_output="${tagged_output}@{${1}}${status_text}"
}

# Render system status and optional hardware segments in compact form.
render_bar() {
    load_color_mode
    output=""
    tagged_output=""

    cpu_value="--"
    cpu_color=""
    if [ "$CPU_PERCENT" -ge 0 ]; then
        cpu_value="${CPU_PERCENT}%"
        cpu_color=$(dbar_color_for "$CPU_PERCENT" "$CPU_WARNING" "$CPU_CRITICAL")
    fi
    append_status_segment c "$DBAR_CPU_ICON $cpu_value" "$cpu_color"

    memory_color=$(dbar_color_for "$MEMORY_PERCENT" "$MEMORY_WARNING" "$MEMORY_CRITICAL")
    append_status_segment m "$DBAR_MEMORY_ICON ${MEMORY_PERCENT}%" "$memory_color"

    network_color=$DBAR_RED
    if [ "$NETWORK_CONNECTED" -eq 1 ]; then
        network_color=$DBAR_GREEN
    fi
    append_status_segment n "$NETWORK_ICON" "$network_color"

    # No separator or placeholder is emitted on machines without a battery.
    if [ "$BATTERY_PERCENT" -ge 0 ]; then
        battery_color=$DBAR_GREEN

        if [ "$BATTERY_STATUS" != Charging ] &&
           [ "$BATTERY_STATUS" != Full ]; then
            if [ "$BATTERY_PERCENT" -le "$BATTERY_CRITICAL" ]; then
                battery_color=$DBAR_RED
            elif [ "$BATTERY_PERCENT" -le "$BATTERY_WARNING" ]; then
                battery_color=$DBAR_ORANGE
            fi
        fi

        append_status_segment b "$BATTERY_ICON ${BATTERY_PERCENT}%" "$battery_color"
    fi

    # Brightness is informational, so a low value is not a warning.
    if [ "$BRIGHTNESS_PERCENT" -ge 0 ]; then
        append_status_segment l "$DBAR_BRIGHTNESS_ICON ${BRIGHTNESS_PERCENT}%" ""
    fi

    # Muted or zero-volume ALSA playback occupies exactly one icon.
    if [ "$VOLUME_PERCENT" -ge 0 ]; then
        if [ "$VOLUME_MUTED" -eq 1 ]; then
            append_status_segment v "$DBAR_VOLUME_MUTED_ICON" "$DBAR_ORANGE"
        else
            append_status_segment v "$DBAR_VOLUME_ICON ${VOLUME_PERCENT}%" "$DBAR_GREEN"
        fi
    fi

    # Disk usage refers to the root filesystem.
    if [ "$DISK_PERCENT" -ge 0 ]; then
        disk_color=$(dbar_color_for "$DISK_PERCENT" "$DISK_WARNING" "$DISK_CRITICAL")
        append_status_segment d "$DBAR_DISK_ICON ${DISK_PERCENT}%" "$disk_color"
    fi

    # Temperature is hidden when no CPU-specific sensor exists.
    if [ "$TEMPERATURE_C" -ge 0 ]; then
        temperature_color=$(dbar_color_for "$TEMPERATURE_C" "$TEMPERATURE_WARNING" "$TEMPERATURE_CRITICAL")
        append_status_segment t "$DBAR_TEMPERATURE_ICON ${TEMPERATURE_C}°" "$temperature_color"
    fi

    # Zero connected devices uses only an icon; add the count when positive.
    if [ "$BLUETOOTH_PRESENT" -eq 1 ]; then
        if [ "$BLUETOOTH_POWERED" -eq 1 ]; then
            bluetooth_text=$DBAR_BLUETOOTH_ON_ICON
            if [ "$BLUETOOTH_CONNECTED" -gt 0 ]; then
                bluetooth_text="$bluetooth_text $BLUETOOTH_CONNECTED"
            fi
            append_status_segment h "$bluetooth_text" "$DBAR_GREEN"
        else
            append_status_segment h "$DBAR_BLUETOOTH_OFF_ICON" "$DBAR_RED"
        fi
    fi

    # Count connected storage devices without counting their partitions.
    if [ "$USB_COUNT" -gt 0 ]; then
        append_status_segment u "$DBAR_USB_ICON $USB_COUNT" ""
    fi

    # Keep the printer icon when idle, append the pending-job count if positive.
    if [ "$PRINTER_COUNT" -gt 0 ]; then
        printer_text=$DBAR_PRINTER_ICON
        if [ "$PRINTER_JOBS" -gt 0 ]; then
            printer_text="$printer_text $PRINTER_JOBS"
        fi
        append_status_segment p "$printer_text" ""
    fi

    append_status_segment k "$DBAR_CLOCK_ICON $CLOCK" ""
}

# Print a single sample without requiring a graphical session.
preview_bar() {
    update_cpu
    update_memory
    update_clock
    update_network
    update_battery
    update_brightness
    update_volume
    update_disk
    update_temperature
    update_bluetooth
    update_usb
    update_printers
    render_bar
    printf '%s\n' "$output"
}

# Drop runtime files only if they belong to our process.
cleanup() {
    if [ -f "$pid_file" ] && [ ! -L "$pid_file" ]; then
        IFS= read -r recorded_pid < "$pid_file" || recorded_pid=""
        if [ "$recorded_pid" = "$$" ]; then
            rm -v "$pid_file"
        fi
    fi
    if [ -d "$lock_directory" ] && [ ! -L "$lock_directory" ]; then
        rmdir -v "$lock_directory" 2>/dev/null || :
    fi
}

# Claim the lock atomically, recovering only unchanged, empty, abandoned locks.
acquire_lock() {
    if mkdir "$lock_directory" 2>/dev/null; then
        return 0
    fi

    if running_pid; then
        echo 'Error: dbar is already running.' >&2
        return 1
    fi
    if [ -L "$lock_directory" ] || [ ! -d "$lock_directory" ]; then
        echo "Error: Unexpected runtime lock: $lock_directory" >&2
        return 1
    fi

    # Remember the directory identity so a replacement is never treated as stale.
    old_lock=$(stat -c '%d:%i:%Y' "$lock_directory" 2>/dev/null) || return 1
    lock_modified=${old_lock##*:}
    case "$lock_modified" in
        ''|*[!0-9]*)
            echo 'Error: Cannot verify the runtime lock age.' >&2
            return 1
            ;;
    esac

    # Allow another starting process time to record its PID before recovery.
    now=$(date +%s)
    if [ $((now - lock_modified)) -lt 3 ]; then
        sleep 3
    fi
    if running_pid; then
        echo 'Error: dbar is already running.' >&2
        return 1
    fi
    if [ "$(stat -c '%d:%i:%Y' "$lock_directory" 2>/dev/null)" != "$old_lock" ]; then
        echo 'Error: Runtime lock changed during recovery.' >&2
        return 1
    fi

    # rmdir refuses nonempty directories; never delete an unknown owner's files.
    if ! rmdir -v "$lock_directory" 2>/dev/null; then
        echo "Error: Nonempty or busy runtime lock: $lock_directory" >&2
        return 1
    fi
    if ! mkdir "$lock_directory" 2>/dev/null; then
        echo 'Error: Another dbar instance acquired the runtime lock.' >&2
        return 1
    fi
    echo 'Recovered abandoned dbar runtime lock.' >&2
}

# Run the bar in the foreground (used by dbar_start).
run_bar() {
    if [ -z "${DISPLAY:-}" ]; then
        echo 'Error: dbar requires an X11 session (DISPLAY is unset).' >&2
        exit 1
    fi
    if ! command -v xsetroot >/dev/null 2>&1; then
        echo 'Error: xsetroot is not installed.' >&2
        exit 1
    fi

    mkdir -vp "$runtime_directory"
    if ! acquire_lock; then
        exit 1
    fi
    if [ -e "$pid_file" ] || [ -L "$pid_file" ]; then
        if running_pid; then
            rmdir -v "$lock_directory" || :
            echo 'Error: dbar is already running.' >&2
            exit 1
        fi
        if [ -L "$pid_file" ] || [ ! -f "$pid_file" ]; then
            rmdir -v "$lock_directory" || :
            echo 'Error: Unexpected PID file. No changes made.' >&2
            exit 1
        fi
    fi

    printf '%s\n' "$$" > "$pid_file"
    trap 'cleanup' 0
    trap 'exit 0' HUP INT TERM
    trap 'redraw_requested=1' USR1

    . "$DBAR_HOME/config.sh"
    . "$DBAR_HOME/lib/colors.sh"
    . "$DBAR_HOME/modules/cpu.sh"
    . "$DBAR_HOME/modules/memory.sh"
    . "$DBAR_HOME/modules/clock.sh"
    . "$DBAR_HOME/modules/network.sh"
    . "$DBAR_HOME/modules/battery.sh"
    . "$DBAR_HOME/modules/brightness.sh"
    . "$DBAR_HOME/modules/volume.sh"
    . "$DBAR_HOME/modules/disk.sh"
    . "$DBAR_HOME/modules/temperature.sh"
    . "$DBAR_HOME/modules/bluetooth.sh"
    . "$DBAR_HOME/modules/usb.sh"
    . "$DBAR_HOME/modules/printers.sh"

    update_cpu
    update_memory
    update_clock
    update_network
    update_battery
    update_brightness
    update_volume
    update_disk
    update_temperature
    update_bluetooth
    update_usb
    update_printers
    previous_output=""
    redraw_requested=1
    seconds=0

    while :; do
        render_bar
        if [ "$redraw_requested" -eq 1 ] || [ "$tagged_output" != "$previous_output" ]; then
            xsetroot -name "$tagged_output"
            previous_output=$tagged_output
            redraw_requested=0
        fi
        # Signals can interrupt sleep; do not let set -e stop the daemon.
        sleep 1 || :
        seconds=$((seconds + 1))
        if [ $((seconds % CPU_INTERVAL)) -eq 0 ]; then
            update_cpu
        fi
        if [ $((seconds % MEMORY_INTERVAL)) -eq 0 ]; then
            update_memory
        fi
        if [ $((seconds % CLOCK_INTERVAL)) -eq 0 ]; then
            update_clock
        fi
        if [ $((seconds % NETWORK_INTERVAL)) -eq 0 ]; then
            update_network
        fi
        if [ $((seconds % BATTERY_INTERVAL)) -eq 0 ]; then
            update_battery
        fi
        if [ $((seconds % BRIGHTNESS_INTERVAL)) -eq 0 ]; then
            update_brightness
        fi
        if [ $((seconds % VOLUME_INTERVAL)) -eq 0 ]; then
            update_volume
        fi
        if [ $((seconds % DISK_INTERVAL)) -eq 0 ]; then
            update_disk
        fi
        if [ $((seconds % TEMPERATURE_INTERVAL)) -eq 0 ]; then
            update_temperature
        fi
        if [ $((seconds % BLUETOOTH_INTERVAL)) -eq 0 ]; then
            update_bluetooth
        fi
        if [ $((seconds % USB_INTERVAL)) -eq 0 ]; then
            update_usb
        fi
        if [ $((seconds % PRINTER_INTERVAL)) -eq 0 ]; then
            update_printers
        fi
    done
}

start_bar() {
    if [ -z "${DISPLAY:-}" ]; then
        echo 'Error: Start dbar from an X11 terminal.' >&2
        exit 1
    fi
    if ! command -v xsetroot >/dev/null 2>&1; then
        echo 'Error: xsetroot is not installed.' >&2
        exit 1
    fi
    if running_pid; then
        echo "dbar is already running (PID $pid)."
        exit 0
    fi

    mkdir -vp "$runtime_directory"
    nohup "$DBAR_HOME/dbar" run </dev/null > "$runtime_directory/dbar.log" 2>&1 &
    spawned_pid=$!

    # Recovery may briefly delay startup; do not report failure too early.
    attempt=0
    while [ "$attempt" -lt 6 ]; do
        sleep 1
        if running_pid; then
            echo "dbar started (PID $pid)."
            return 0
        fi
        if ! kill -0 "$spawned_pid" 2>/dev/null; then
            break
        fi
        attempt=$((attempt + 1))
    done

    echo "Error: Could not start dbar. Check $runtime_directory/dbar.log" >&2
    exit 1
}

stop_bar() {
    if running_pid; then
        kill -TERM "$pid"
        echo "Stopping dbar (PID $pid)."
    else
        echo 'dbar is not running.'
    fi
}

refresh_bar() {
    if running_pid; then
        kill -USR1 "$pid"
        echo 'dbar refresh requested.'
    else
        echo 'dbar is not running.' >&2
        exit 1
    fi
}

set_colors() {
    if [ -L "$mode_file" ] || { [ -e "$mode_file" ] && [ ! -f "$mode_file" ]; }; then
        echo 'Error: Unexpected color-mode file. No changes made.' >&2
        exit 1
    fi
    printf '%s\n' "$1" > "$mode_file"
    echo "dbar colors: $1"
    if running_pid; then
        kill -USR1 "$pid"
    fi
}

# Debug only: identify the clicked segment. Keep the terminal open for inspection.
debug_click() {
    [ "$#" -eq 2 ] || {
        echo 'Usage: dbar click {c|m|n|b|l|v|d|t|h|u|p|k} {1|2|3}' >&2
        return 2
    }
    case "$1" in
        c) clicked_module=cpu ;;
        m) clicked_module=ram ;;
        n) clicked_module=wifi ;;
        b) clicked_module=battery ;;
        l) clicked_module=brightness ;;
        v) clicked_module=volume ;;
        d) clicked_module=disk ;;
        t) clicked_module=temperature ;;
        h) clicked_module=bluetooth ;;
        u) clicked_module=usb ;;
        p) clicked_module=printer ;;
        k) clicked_module=clock ;;
        *) echo 'Error: Unknown status segment.' >&2; return 2 ;;
    esac
    case "$2" in
        1) clicked_button=left ;;
        2) clicked_button=middle ;;
        3) clicked_button=right ;;
        *) echo 'Error: Unsupported mouse button.' >&2; return 2 ;;
    esac
    command -v st >/dev/null 2>&1 || {
        echo 'Error: st is not on PATH.' >&2
        return 1
    }
    exec st -e sh -c '
        echo "$1"
        printf "Mouse button: %s\n" "$2"
        printf "Press Enter to close..."
        IFS= read -r response || :
    ' sh "$clicked_module" "$clicked_button"
}

# Process control can run without X11; only 'run' and 'start' require a display.
operation=${1:-help}
case "$operation" in
    run) run_bar ;;
    preview)
        . "$DBAR_HOME/config.sh"
        . "$DBAR_HOME/lib/colors.sh"
        . "$DBAR_HOME/modules/cpu.sh"
        . "$DBAR_HOME/modules/memory.sh"
        . "$DBAR_HOME/modules/clock.sh"
    . "$DBAR_HOME/modules/network.sh"
    . "$DBAR_HOME/modules/battery.sh"
    . "$DBAR_HOME/modules/brightness.sh"
    . "$DBAR_HOME/modules/volume.sh"
    . "$DBAR_HOME/modules/disk.sh"
    . "$DBAR_HOME/modules/temperature.sh"
    . "$DBAR_HOME/modules/bluetooth.sh"
    . "$DBAR_HOME/modules/usb.sh"
    . "$DBAR_HOME/modules/printers.sh"
        preview_bar
        ;;
    start) start_bar ;;
    stop) stop_bar ;;
    restart) stop_bar; sleep 1; start_bar ;;
    status)
        if running_pid; then
            echo "dbar is running (PID $pid)."
        else
            echo 'dbar is not running.'
            exit 1
        fi
        ;;
    refresh) refresh_bar ;;
    click) shift; debug_click "$@" ;;
    colors-on) set_colors on ;;
    colors-off) set_colors off ;;
    *)
        printf 'Usage: dbar {start|stop|restart|status|refresh|colors-on|colors-off|preview|click}\n' >&2
        exit 1
        ;;
esac
