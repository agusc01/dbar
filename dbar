#!/bin/sh
set -eu

# The repository lives at ~/.config/dbar when installed normally.
DBAR_HOME=${DBAR_HOME:-"$HOME/.config/dbar"}
mode_file="$DBAR_HOME/color-mode"
runtime_directory="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/dbar"
pid_file="$runtime_directory/dbar.pid"
lock_directory="$runtime_directory/lock"

# Only trust a PID if it still belongs to this specific bar executable.
running_pid() {
    [ -f "$pid_file" ] && [ ! -L "$pid_file" ] || return 1
    IFS= read -r pid < "$pid_file" || return 1
    case "$pid" in
        ''|0|*[!0-9]*) return 1 ;;
    esac
    kill -0 "$pid" 2>/dev/null || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    tr '\000' '\n' < "/proc/$pid/cmdline" | grep -Fx "$DBAR_HOME/dbar" >/dev/null 2>&1
}

# Read the persisted color mode, defaulting to color when unset.
load_color_mode() {
    DBAR_COLOR_MODE=on
    if [ -f "$mode_file" ] && [ ! -L "$mode_file" ]; then
        IFS= read -r DBAR_COLOR_MODE < "$mode_file" || :
    fi
    case "$DBAR_COLOR_MODE" in
        on|off) ;;
        *) DBAR_COLOR_MODE=on ;;
    esac
}

# Render concise status values; monochrome mode must contain no color bytes.
render_bar() {
    load_color_mode

    cpu_value="--"
    if [ "$CPU_PERCENT" -ge 0 ]; then
        cpu_value="${CPU_PERCENT}%"
    fi

    cpu_text="CPU $cpu_value"
    memory_text="RAM ${MEMORY_PERCENT}%"
    separator=" · "

    if [ "$DBAR_COLOR_MODE" = "off" ]; then
        output="${cpu_text}${separator}${memory_text}${separator}${CLOCK}"
        return
    fi

    cpu_color=$DBAR_NORMAL
    if [ "$CPU_PERCENT" -ge 0 ]; then
        cpu_color=$(dbar_color_for "$CPU_PERCENT" "$CPU_WARNING" "$CPU_CRITICAL")
    fi
    memory_color=$(dbar_color_for "$MEMORY_PERCENT" "$MEMORY_WARNING" "$MEMORY_CRITICAL")

    output="${cpu_color}${cpu_text}${DBAR_NORMAL}${separator}${memory_color}${memory_text}${DBAR_NORMAL}${separator}${CLOCK}"
}

# Print a single sample without requiring a graphical session.
preview_bar() {
    update_cpu
    update_memory
    update_clock
    render_bar
    printf '%s\n' "$output"
}

# Drop runtime files only if they belong to our process.
cleanup() {
    if [ -f "$pid_file" ] && [ ! -L "$pid_file" ]; then
        IFS= read -r recorded_pid < "$pid_file" || recorded_pid=""
        if [ "$recorded_pid" = "$$" ]; then
            rm -v "$pid_file"
        fi
    fi
    if [ -d "$lock_directory" ] && [ ! -L "$lock_directory" ]; then
        rmdir -v "$lock_directory" 2>/dev/null || :
    fi
}

# Claim the lock atomically, recovering only unchanged, empty, abandoned locks.
acquire_lock() {
    if mkdir "$lock_directory" 2>/dev/null; then
        return 0
    fi

    if running_pid; then
        echo 'Error: dbar is already running.' >&2
        return 1
    fi
    if [ -L "$lock_directory" ] || [ ! -d "$lock_directory" ]; then
        echo "Error: Unexpected runtime lock: $lock_directory" >&2
        return 1
    fi

    # Remember the directory identity so a replacement is never treated as stale.
    old_lock=$(stat -c '%d:%i:%Y' "$lock_directory" 2>/dev/null) || return 1
    lock_modified=${old_lock##*:}
    case "$lock_modified" in
        ''|*[!0-9]*)
            echo 'Error: Cannot verify the runtime lock age.' >&2
            return 1
            ;;
    esac

    # Allow another starting process time to record its PID before recovery.
    now=$(date +%s)
    if [ $((now - lock_modified)) -lt 3 ]; then
        sleep 3
    fi
    if running_pid; then
        echo 'Error: dbar is already running.' >&2
        return 1
    fi
    if [ "$(stat -c '%d:%i:%Y' "$lock_directory" 2>/dev/null)" != "$old_lock" ]; then
        echo 'Error: Runtime lock changed during recovery.' >&2
        return 1
    fi

    # rmdir refuses nonempty directories; never delete an unknown owner's files.
    if ! rmdir -v "$lock_directory" 2>/dev/null; then
        echo "Error: Nonempty or busy runtime lock: $lock_directory" >&2
        return 1
    fi
    if ! mkdir "$lock_directory" 2>/dev/null; then
        echo 'Error: Another dbar instance acquired the runtime lock.' >&2
        return 1
    fi
    echo 'Recovered abandoned dbar runtime lock.' >&2
}

# Run the bar in the foreground (used by dbar_start).
run_bar() {
    if [ -z "${DISPLAY:-}" ]; then
        echo 'Error: dbar requires an X11 session (DISPLAY is unset).' >&2
        exit 1
    fi
    if ! command -v xsetroot >/dev/null 2>&1; then
        echo 'Error: xsetroot is not installed.' >&2
        exit 1
    fi

    mkdir -vp "$runtime_directory"
    if ! acquire_lock; then
        exit 1
    fi
    if [ -e "$pid_file" ] || [ -L "$pid_file" ]; then
        if running_pid; then
            rmdir -v "$lock_directory" || :
            echo 'Error: dbar is already running.' >&2
            exit 1
        fi
        if [ -L "$pid_file" ] || [ ! -f "$pid_file" ]; then
            rmdir -v "$lock_directory" || :
            echo 'Error: Unexpected PID file. No changes made.' >&2
            exit 1
        fi
    fi

    printf '%s\n' "$$" > "$pid_file"
    trap 'cleanup' 0
    trap 'exit 0' HUP INT TERM
    trap 'redraw_requested=1' USR1

    . "$DBAR_HOME/config.sh"
    . "$DBAR_HOME/lib/colors.sh"
    . "$DBAR_HOME/modules/cpu.sh"
    . "$DBAR_HOME/modules/memory.sh"
    . "$DBAR_HOME/modules/clock.sh"

    update_cpu
    update_memory
    update_clock
    previous_output=""
    redraw_requested=1
    seconds=0

    while :; do
        render_bar
        if [ "$redraw_requested" -eq 1 ] || [ "$output" != "$previous_output" ]; then
            xsetroot -name "$output"
            previous_output=$output
            redraw_requested=0
        fi
        # Signals can interrupt sleep; do not let set -e stop the daemon.
        sleep 1 || :
        seconds=$((seconds + 1))
        if [ $((seconds % CPU_INTERVAL)) -eq 0 ]; then
            update_cpu
        fi
        if [ $((seconds % MEMORY_INTERVAL)) -eq 0 ]; then
            update_memory
        fi
        if [ $((seconds % CLOCK_INTERVAL)) -eq 0 ]; then
            update_clock
        fi
    done
}

start_bar() {
    if [ -z "${DISPLAY:-}" ]; then
        echo 'Error: Start dbar from an X11 terminal.' >&2
        exit 1
    fi
    if ! command -v xsetroot >/dev/null 2>&1; then
        echo 'Error: xsetroot is not installed.' >&2
        exit 1
    fi
    if running_pid; then
        echo "dbar is already running (PID $pid)."
        exit 0
    fi

    mkdir -vp "$runtime_directory"
    nohup "$DBAR_HOME/dbar" run </dev/null > "$runtime_directory/dbar.log" 2>&1 &
    spawned_pid=$!

    # Recovery may briefly delay startup; do not report failure too early.
    attempt=0
    while [ "$attempt" -lt 6 ]; do
        sleep 1
        if running_pid; then
            echo "dbar started (PID $pid)."
            return 0
        fi
        if ! kill -0 "$spawned_pid" 2>/dev/null; then
            break
        fi
        attempt=$((attempt + 1))
    done

    echo "Error: Could not start dbar. Check $runtime_directory/dbar.log" >&2
    exit 1
}

stop_bar() {
    if running_pid; then
        kill -TERM "$pid"
        echo "Stopping dbar (PID $pid)."
    else
        echo 'dbar is not running.'
    fi
}

refresh_bar() {
    if running_pid; then
        kill -USR1 "$pid"
        echo 'dbar refresh requested.'
    else
        echo 'dbar is not running.' >&2
        exit 1
    fi
}

set_colors() {
    if [ -L "$mode_file" ] || { [ -e "$mode_file" ] && [ ! -f "$mode_file" ]; }; then
        echo 'Error: Unexpected color-mode file. No changes made.' >&2
        exit 1
    fi
    printf '%s\n' "$1" > "$mode_file"
    echo "dbar colors: $1"
    if running_pid; then
        kill -USR1 "$pid"
    fi
}

# Process control can run without X11; only 'run' and 'start' require a display.
operation=${1:-help}
case "$operation" in
    run) run_bar ;;
    preview)
        . "$DBAR_HOME/config.sh"
        . "$DBAR_HOME/lib/colors.sh"
        . "$DBAR_HOME/modules/cpu.sh"
        . "$DBAR_HOME/modules/memory.sh"
        . "$DBAR_HOME/modules/clock.sh"
        preview_bar
        ;;
    start) start_bar ;;
    stop) stop_bar ;;
    restart) stop_bar; sleep 1; start_bar ;;
    status)
        if running_pid; then
            echo "dbar is running (PID $pid)."
        else
            echo 'dbar is not running.'
            exit 1
        fi
        ;;
    refresh) refresh_bar ;;
    colors-on) set_colors on ;;
    colors-off) set_colors off ;;
    *)
        printf 'Usage: dbar {start|stop|restart|status|refresh|colors-on|colors-off|preview}\n' >&2
        exit 1
        ;;
esac
